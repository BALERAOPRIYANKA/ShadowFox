# ==========================
# 6. DIE ROLL
# ==========================

import random

count6 = 0
count1 = 0
two6 = 0
previous = 0

print("\nDice Rolls:")

for i in range(20):
    roll = random.randint(1, 6)
    print(roll, end=" ")

    if roll == 6:
        count6 += 1

    if roll == 1:
        count1 += 1

    if previous == 6 and roll == 6:
        two6 += 1

    previous = roll

print("\n\nNumber of 6s:", count6)
print("Number of 1s:", count1)
print("Two consecutive 6s:", two6)


# ==========================
# 7. JUMPING JACKS
# ==========================

completed = 0

for i in range(10):
    print("\nPerform 10 Jumping Jacks.")
    completed += 10

    if completed == 100:
        print("Congratulations! You completed 100 jumping jacks.")
        break

    tired = input("Are you tired? (yes/no): ").lower()

    if tired == "yes" or tired == "y":
        skip = input("Do you want to skip the remaining sets? (yes/no): ").lower()

        if skip == "yes" or skip == "y":
            print("You completed a total of", completed, "jumping jacks.")
            break

    print("Remaining jumping jacks:", 100 - completed)
