# 3. BMI
# ==========================

height = float(input("\nEnter height (m): "))
weight = float(input("Enter weight (kg): "))

bmi = weight / (height ** 2)

print("BMI =", round(bmi, 2))

if bmi >= 30:
    print("Obesity")
elif bmi >= 25:
    print("Overweight")
elif bmi >= 18.5:
    print("Normal")
else:
    print("Underweight")


